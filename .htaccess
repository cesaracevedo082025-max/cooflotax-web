# 1. REGLAS DE ENRUTAMIENTO PARA NEXT.JS (Quita la necesidad de poner .html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o directorio ya existe, no hacer nada
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Si existe el archivo con la extensión .html, mostrar ese archivo
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 2. HABILITAR COMPRESIÓN GZIP (Rendimiento)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json font/woff2 image/svg+xml
</IfModule>

# 3. FORZAR CACHÉ (Rendimiento)
<IfModule mod_headers.c>
  # Caché de 1 año para videos e imágenes
  <FilesMatch "\.(mp4|webp|jpg|jpeg|png|gif|ico|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Caché de 1 mes para CSS y JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>